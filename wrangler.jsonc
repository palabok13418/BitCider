{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bitcider",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/*/manifest.json",
      "/*/search",
      "/*/stream/*"
    ]
  }
}
