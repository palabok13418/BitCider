# Public URL of the authoritative Deplexo backend. Set on Deplexo only.
BITCIDER_PUBLIC_URL=https://your-bitcider-app.de.deplexo.com

# Generate a long random value. Set the same secret on Deplexo, Netlify and Cloudflare.
# Server-side only. Never use a VITE_ prefix.
BITCIDER_PROXY_SECRET=replace-with-a-long-random-secret

# Generate once with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Set ONLY as a Deplexo secret. Keep it stable; changing or losing it makes
# environment-encrypted Cider tokens unreadable. Existing volume-key records
# are upgraded automatically at backend startup.
BITCIDER_ENCRYPTION_KEY=replace-with-32-byte-base64url-secret

# Deplexo's persistent application volume is mounted at /data.
BITCIDER_DATA_DIR=/data/bitcider

# Optional in-browser Cider request deadline (1000-30000 ms).
BITCIDER_CIDER_REQUEST_TIMEOUT_MS=20000

# Optional comma-separated extra HTTPS origins allowed to manage accounts directly.
# Netlify/Cloudflare gateways do not need this because they use BITCIDER_PROXY_SECRET.
BITCIDER_ALLOWED_ORIGINS=
