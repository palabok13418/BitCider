# Public URL of the authoritative Deplexo backend. Set on Deplexo only.
BITCIDER_PUBLIC_URL=https://your-bitcider-app.de.deplexo.com

# Generate a long random value. Set the same secret on Deplexo, Netlify and Cloudflare.
# Server-side only. Never use a VITE_ prefix.
BITCIDER_PROXY_SECRET=replace-with-a-long-random-secret

# Deplexo's persistent application volume is mounted at /data.
BITCIDER_DATA_DIR=/data/bitcider

# Reserved for the future per-user Cider relay. A hosted process cannot reach
# a user's desktop Cider API through its own 127.0.0.1.
CIDER_API_URL=http://127.0.0.1:10767
