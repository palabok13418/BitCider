# Set this to the public HTTPS hostname that routes to this BitCider server.
# Without it, BitCider shows a LAN address, which requires BitChord to be on the same network.
BITCIDER_PUBLIC_URL=https://your-public-host.example

# Optional. Defaults to Cider's local desktop API.
CIDER_API_URL=http://127.0.0.1:10767

# Optional. Defaults to 8787.
PORT=8787

# Maximum number of Cider library songs BitCider scans for each search (default 4000; max 10000).
BITCIDER_SEARCH_MAX_LIBRARY_SONGS=4000

# Pause Cider after retrieving a stream URL so BitChord is the audible output.
BITCIDER_PAUSE_CIDER_AFTER_RESOLVE=true
